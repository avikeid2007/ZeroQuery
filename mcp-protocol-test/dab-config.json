{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('ZQ_DB_CONN')"
  },
  "runtime": {
    "rest": { "enabled": true },
    "graphql": { "enabled": true },
    "mcp": {
      "enabled": true,
      "description": "Zeroquery Phase 4 protocol test server"
    }
  },
  "entities": {
    "Products": {
      "description": "Product catalog with pricing and inventory",
      "source": { "object": "dbo.Products", "type": "table" },
      "fields": [
        { "name": "ProductID", "primary-key": true, "description": "Unique product identifier" },
        { "name": "ProductName", "description": "Display name of the product" },
        { "name": "UnitPrice", "description": "Retail price in USD" },
        { "name": "UnitsInStock", "description": "Number of units currently in stock" }
      ],
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read",
              "fields": { "include": ["ProductID", "ProductName", "UnitPrice", "UnitsInStock"] }
            }
          ]
        }
      ]
    }
  }
}
